<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_vismasign_backend_form" model="ir.ui.view">
        <field name="name">vismasign.backend.form</field>
        <field name="model">vismasign.backend</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                        class="btn-primary"
                    />
                    <button
                        name="action_open_partner_onboarding_wizard"
                        type="object"
                        string="Partner onboarding"
                        class="btn-secondary"
                        invisible="auth_mode != 'partner'"
                    />
                    <button
                        name="action_open_partner_invite_wizard"
                        type="object"
                        string="Send partner invite"
                        class="btn-secondary"
                        invisible="auth_mode != 'partner'"
                    />
                </header>

                <sheet>
                    <group>
                        <field name="company_id" />
                        <field name="base_url" />
                        <field name="auth_mode" />
                    </group>

                    <group
                        string="Customer credentials (HMAC)"
                        invisible="auth_mode != 'hmac'"
                    >
                        <field
                            name="client_identifier"
                            required="auth_mode == 'hmac'"
                        />
                        <field
                            name="secret_key_b64"
                            password="True"
                            required="auth_mode == 'hmac'"
                        />
                    </group>

                    <group
                        string="Partner authentication (OAuth2)"
                        invisible="auth_mode != 'partner'"
                    >
                        <field
                            name="partner_client_id"
                            required="auth_mode == 'partner'"
                        />
                        <field
                            name="partner_client_secret"
                            password="True"
                            required="auth_mode == 'partner'"
                        />
                        <field
                            name="partner_scope"
                            placeholder="organization_search organization_create organization_access document_create ..."
                        />
                        <field
                            name="as_organization_uuid"
                            placeholder="Target Visma Sign organization UUID"
                        />
                    </group>

                    <group
                        string="Partner token status"
                        invisible="auth_mode != 'partner'"
                    >
                        <field name="partner_access_token" readonly="1" />
                        <field name="partner_token_expires_at" readonly="1" />
                    </group>

                    <group string="Default document category">
                        <field name="category_name" placeholder="e.g. Agreements" />
                        <field
                            name="category_description"
                            placeholder="Optional description shown in Visma Sign"
                        />
                        <field name="category_uuid" readonly="1" />
                    </group>

                    <group string="Inviter (optional)">
                        <field name="inviter_name" />
                        <field name="inviter_email" />
                    </group>

                    <group string="Signing behavior (optional)">
                        <field name="default_sign_as_organization" />
                        <field name="default_sign_as_inviter_organization" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vismasign_backend_tree" model="ir.ui.view">
        <field name="name">vismasign.backend.tree</field>
        <field name="model">vismasign.backend</field>
        <field name="arch" type="xml">
            <tree>
                <field name="company_id" />
                <field name="base_url" />
                <field name="auth_mode" />
                <field name="as_organization_uuid" invisible="auth_mode != 'partner'" />
            </tree>
        </field>
    </record>

    <record id="action_vismasign_backend" model="ir.actions.act_window">
        <field name="name">Visma Sign Backends</field>
        <field name="res_model">vismasign.backend</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_vismasign_root"
        parent="connector.menu_connector_root"
        name="Visma Sign"
        sequence="10"
        groups="connector.group_connector_manager"
    />
    <menuitem
        id="menu_vismasign_backend"
        name="Backends"
        parent="menu_vismasign_root"
        action="action_vismasign_backend"
    />
</odoo>
