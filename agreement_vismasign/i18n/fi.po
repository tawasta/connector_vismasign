#. module: agreement_vismasign
#: model_terms:ir.ui.view,arch_db:agreement_vismasign.res_config_settings_view_form_agreement_vismasign
msgid ""
"If enabled, confirming a quotation that has an agreement type set "
"automatically creates the linked agreement. Otherwise, use the 'Create "
"Agreement' button on the quotation."
msgstr ""
"Kun asetus on käytössä, sopimus luodaan automaattisesti, kun tarjous, jolle "
"on valittu sopimustyyppi, vahvistetaan. Muussa tapauksessa sopimus luodaan "
"tarjouksen Luo sopimus -painikkeella."

#. module: agreement_vismasign
#. odoo-python
#: code:addons/agreement_vismasign/models/agreement.py:0
#, python-format
msgid "No Visma Sign backend is configured for company %s."
msgstr "Yritykselle %s ei ole määritetty Visma Sign -yhteyttä."

#. module: agreement_vismasign
#. odoo-python
#: code:addons/agreement_vismasign/models/agreement.py:0
#, python-format
msgid ""
"No Visma Sign report is configured for agreement type %(type)s. Set the "
"report on the agreement type."
msgstr ""
"Sopimustyypille %(type)s ei ole valittu Visma Sign -raporttia. Valitse "
"raportti sopimustyypin asetuksista."

#. module: agreement_vismasign
#: model:ir.model.fields,help:agreement_vismasign.field_agreement_type__report_id
msgid ""
"Report used to render the document sent to Visma Sign for agreements of "
"this type: an agreement report, or a sale order report rendered from the "
"quotation the agreement was created from."
msgstr ""
"Raportti, jolla tämän tyypin sopimuksista muodostetaan Visma Signiin "
"lähetettävä dokumentti. Raportti voi olla sopimuksen raportti tai "
"myyntitilauksen raportti, jolloin dokumentti muodostetaan tarjoukselta, "
"josta sopimus on luotu."

#. module: agreement_vismasign
#: model_terms:ir.ui.view,arch_db:agreement_vismasign.view_agreement_form_inherit_vismasign
msgid "Send for Signature"
msgstr "Lähetä allekirjoitettavaksi"

