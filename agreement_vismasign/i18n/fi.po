#. odoo-python
#: code:addons/agreement_vismasign/models/agreement.py:0
#, python-format
msgid ""
"The Visma Sign report %(report)s is for model %(model)s. Only agreement and "
"sale order reports are supported."
msgstr ""
"Visma Sign -raportti %(report)s on tarkoitettu mallille %(model)s. Vain "
"sopimuksen ja myyntitilauksen raportteja voi käyttää."

#. module: agreement_vismasign
#. odoo-python
#: code:addons/agreement_vismasign/models/agreement.py:0
#, python-format
msgid ""
"The Visma Sign report %(report)s is rendered from the quotation, so the "
"agreement must be linked to exactly one quotation (now linked to "
"%(count)s)."
msgstr ""
"Visma Sign -raportti %(report)s muodostetaan tarjoukselta, joten sopimuksen "
"on oltava liitetty täsmälleen yhteen tarjoukseen. Liitettyjä tarjouksia on "
"nyt %(count)s."

