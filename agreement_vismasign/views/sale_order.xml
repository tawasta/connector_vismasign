<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_order_form_inherit_agreement_vismasign" model="ir.ui.view">
        <field name="name">sale.order.form.agreement.vismasign.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_create_agreement"
                    type="object"
                    string="Create Agreement"
                    invisible="not agreement_type_id or agreement_id"
                    groups="agreement.group_use_agreement_type"
                />
            </xpath>
        </field>
    </record>

</odoo>
