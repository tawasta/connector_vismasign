<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_order_form_inherit_vismasign" model="ir.ui.view">
        <field name="name">sale.order.form.vismasign.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button
                    name="action_vismasign_send"
                    type="object"
                    string="Send for Signature"
                    class="btn-primary"
                />
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page name="vismasign" string="Visma Sign">
                    <group>
                        <group string="Status">
                            <field name="vismasign_status" readonly="1"/>
                            <field name="vismasign_last_check" readonly="1"/>
                        </group>
                        <group string="Identifiers">
                            <field name="vismasign_document_uuid" readonly="1"/>
                            <field name="vismasign_file_uuid" readonly="1"/>
                            <field name="vismasign_invitation_uuid" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>