<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_sale_vismasign" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.vismasign</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">

                <setting id="sale_vismasign_report_xmlid"
                    string="Visma Sign Report"
                    help="Technical report action XML-ID used to generate the PDF sent for signing.">
                    <field name="vismasign_report_xmlid" placeholder="sale.action_report_saleorder"/>
                    <div class="text-muted">
                        Enter the report action XML-ID, for example:
                        <span class="fw-bold">sale.action_report_saleorder</span>
                    </div>
                </setting>

                <setting id="sale_vismasign_post_sign_action"
                    string="Visma Sign Post-Sign Action"
                    help="Choose what happens after the quotation has been fully signed in Visma Sign.">
                    <field name="vismasign_post_sign_action" class="o_light_label" widget="radio"/>
                    <div class="text-muted">
                        Confirm the quotation automatically or move it to the custom signed state.
                    </div>
                </setting>

            </xpath>

        </field>
    </record>

</odoo>